{
  "name": "freshcart-market",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "infra:up": "docker compose up -d postgres redis meilisearch",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis meilisearch",
    "db:migrate": "pnpm --filter @freshcart/api prisma:migrate",
    "db:seed": "pnpm --filter @freshcart/api prisma:seed",
    "db:studio": "pnpm --filter @freshcart/api exec prisma studio",
    "ops:readiness": "node apps/api/scripts/production-readiness.cjs",
    "ops:readiness:strict": "node apps/api/scripts/production-readiness.cjs --strict",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
