generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  ACTIVE
  DISABLED
  BLOCKED
}

enum AdminStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRING_SOON
  EXPIRED
  DISABLED
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  NOT_REQUIRED
  COD_PENDING
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  MOCK_ONLINE
  RAZORPAY
}

enum FulfillmentStatus {
  NOT_STARTED
  PICKING
  PACKED
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
}

enum DeliveryAssignmentStatus {
  UNASSIGNED
  ASSIGNED
  ACCEPTED
  PICKED_UP
  OUT_FOR_DELIVERY
  NEARBY
  DELIVERED
  FAILED_DELIVERY
  CANCELLED
}

enum SupportConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum PromotionStatus {
  DRAFT
  LIVE
  SCHEDULED
  PAUSED
  EXPIRED
  ARCHIVED
}

enum RefundStatus {
  REQUESTED
  REVIEWING
  APPROVED
  REJECTED
  PROCESSED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  LIVE
  SCHEDULED
  PAUSED
  ARCHIVED
}

model Customer {
  id             String                          @id @default(uuid())
  phone          String?                         @unique
  email          String?                         @unique
  firstName      String?
  lastName       String?
  status         CustomerStatus                  @default(ACTIVE)
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  addresses      CustomerAddress[]
  carts          Cart[]
  loyaltyAccount LoyaltyAccount?
  notifications  CustomerNotificationPreference?
  orders         Order[]
  reviews        ProductReview[]
  searchHistory  SearchHistory[]
  sessions       CustomerSession[]
  supportThreads SupportConversation[]
  wallet         Wallet?
  wishlist       Wishlist?

  @@index([status])
}

model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String
  label         String
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String
  landmark      String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([postalCode])
}

model CustomerOtpCode {
  id           String    @id @default(uuid())
  phone        String
  codeHash     String
  purpose      String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model CustomerSession {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([expiresAt])
}

model CustomerNotificationPreference {
  id           String   @id @default(uuid())
  customerId   String   @unique
  orderUpdates Boolean  @default(true)
  offers       Boolean  @default(true)
  wallet       Boolean  @default(true)
  support      Boolean  @default(true)
  email        Boolean  @default(true)
  whatsapp     Boolean  @default(true)
  sms          Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id])
}

model AdminUser {
  id               String                @id @default(uuid())
  email            String                @unique
  passwordHash     String
  name             String
  status           AdminStatus           @default(INVITED)
  twoFactorEnabled Boolean               @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  auditLogs        AdminAuditLog[]
  loginChallenges  AdminLoginChallenge[]
  roles            AdminUserRole[]
  sessions         AdminSession[]
  supportThreads   SupportConversation[] @relation("AssignedSupportAdmin")

  @@index([status])
}

model AdminRole {
  id          String                @id @default(uuid())
  name        String                @unique
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  permissions AdminRolePermission[]
  users       AdminUserRole[]
}

model AdminPermission {
  id        String                @id @default(uuid())
  key       String                @unique
  label     String
  module    String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  roles     AdminRolePermission[]

  @@index([module])
}

model AdminUserRole {
  adminUserId String
  roleId      String
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  role        AdminRole @relation(fields: [roleId], references: [id])

  @@id([adminUserId, roleId])
}

model AdminRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime        @default(now())
  permission   AdminPermission @relation(fields: [permissionId], references: [id])
  role         AdminRole       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model AdminSession {
  id          String    @id @default(uuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminLoginChallenge {
  id           String    @id @default(uuid())
  adminUserId  String
  tokenHash    String    @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminStaffProfile {
  id          String   @id @default(uuid())
  adminUserId String   @unique
  phone       String?
  shift       String?
  zone        String?
  performance String?
  rating      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminStaffShift {
  id        String   @id @default(uuid())
  staffId   String?
  name      String
  role      String
  shift     String
  zone      String
  state     String   @default("Scheduled")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([state])
  @@index([zone])
}

model AdminStaffActivity {
  id        String   @id @default(uuid())
  staffId   String?
  staff     String
  action    String
  module    String
  risk      String   @default("Low")
  time      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([risk])
  @@index([module])
}

model Category {
  id             String                @id @default(uuid())
  name           String
  slug           String                @unique
  note           String?
  image          String?
  status         ProductStatus         @default(ACTIVE)
  featured       Boolean               @default(false)
  sortOrder      Int                   @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  placements     StorefrontPlacement[]
  products       Product[]

  @@index([status])
  @@index([featured, sortOrder])
}

model CategoryProductMapping {
  sku        String   @id
  product    String
  categoryId String
  status     String   @default("Active")
  sales      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
}

model CategoryOfferPlacement {
  id         String   @id @default(uuid())
  categoryId String
  title      String
  placement  String
  status     String   @default("Scheduled")
  valid      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
}

model Product {
  id                String          @id @default(uuid())
  categoryId        String
  name              String
  slug              String          @unique
  sku               String          @unique
  unit              String
  description       String
  supplierName      String?
  price             Decimal         @db.Decimal(10, 2)
  salePrice         Decimal?        @db.Decimal(10, 2)
  badge             String?
  status            ProductStatus   @default(DRAFT)
  stockStatus       InventoryStatus @default(IN_STOCK)
  averageRating     Decimal         @default(0) @db.Decimal(3, 2)
  reviewCount       Int             @default(0)
  tags              String[]        @default([])
  dietaryTags       String[]        @default([])
  nutrition         Json?
  replacementPolicy String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  cartItems         CartItem[]
  category          Category        @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  inventoryItems    InventoryItem[]
  orderItems        OrderItem[]
  reviews           ProductReview[]
  variants          ProductVariant[]
  wishlistItems     WishlistItem[]

  @@index([categoryId])
  @@index([status])
  @@index([stockStatus])
}

model ProductImage {
  id        String   @id @default(uuid())
  key       String?  @unique
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  name      String
  sku       String   @unique
  unit      String
  price     Decimal  @db.Decimal(10, 2)
  salePrice Decimal? @db.Decimal(10, 2)
  active    Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

model ProductReview {
  id           String              @id @default(uuid())
  productId    String
  customerId   String
  orderId      String?
  rating       Int
  title        String?
  body         String
  status       ContentStatus       @default(DRAFT)
  helpfulCount Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  customer     Customer            @relation(fields: [customerId], references: [id])
  images       ReviewImage[]
  order        Order?              @relation(fields: [orderId], references: [id])
  product      Product             @relation(fields: [productId], references: [id])
  votes        ReviewHelpfulVote[]

  @@index([productId, status])
  @@index([customerId])
}

model ReviewImage {
  id        String        @id @default(uuid())
  reviewId  String
  url       String
  altText   String?
  createdAt DateTime      @default(now())
  review    ProductReview @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
}

model ReviewHelpfulVote {
  reviewId   String
  customerId String
  createdAt  DateTime      @default(now())
  review     ProductReview @relation(fields: [reviewId], references: [id])

  @@id([reviewId, customerId])
}

model Branch {
  id             String              @id @default(uuid())
  name           String
  code           String              @unique
  phone          String?
  addressLine1   String
  city           String
  state          String
  postalCode     String
  latitude       Decimal?            @db.Decimal(10, 7)
  longitude      Decimal?            @db.Decimal(10, 7)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deliverySlots  DeliverySlot[]
  inventoryItems InventoryItem[]
  orders         Order[]
  serviceAreas   BranchServiceArea[]

  @@index([active])
  @@index([postalCode])
}

model BranchServiceArea {
  id         String   @id @default(uuid())
  branchId   String
  areaName   String
  postalCode String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  branch     Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([postalCode, active])
}

model ServiceabilityZone {
  id          String   @id @default(uuid())
  name        String
  postalCodes String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model InventoryItem {
  id          String           @id @default(uuid())
  productId   String
  branchId    String
  sku         String
  onHand      Int              @default(0)
  reserved    Int              @default(0)
  threshold   Int              @default(5)
  status      InventoryStatus  @default(IN_STOCK)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  batches     InventoryBatch[]
  branch      Branch           @relation(fields: [branchId], references: [id])
  ledger      StockLedger[]
  product     Product          @relation(fields: [productId], references: [id])

  @@unique([branchId, sku])
  @@index([productId])
  @@index([status])
}

model InventoryBatch {
  id              String        @id @default(uuid())
  inventoryItemId String
  batchCode       String
  quantity        Int
  expiresAt       DateTime?
  receivedAt      DateTime      @default(now())
  costPrice       Decimal?      @db.Decimal(10, 2)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([expiresAt])
}

model StockLedger {
  id              String        @id @default(uuid())
  inventoryItemId String
  type            String
  quantity        Int
  note            String?
  referenceType   String?
  referenceId     String?
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([createdAt])
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  status         String          @default("ACTIVE")
  categories     String[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([status])
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  supplierId  String
  poNumber    String              @unique
  status      String              @default("DRAFT")
  totalAmount Decimal             @default(0) @db.Decimal(12, 2)
  expectedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]
  payments    SupplierPayment[]
  supplier    Supplier            @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String?
  name            String
  quantity        Int
  unitCost        Decimal       @db.Decimal(10, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

model SupplierPayment {
  id              String        @id @default(uuid())
  purchaseOrderId String
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([status])
}

model SupplierExportRecord {
  id        String   @id
  title     String
  format    String   @default("CSV")
  status    String   @default("Ready")
  time      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([format])
}

model Cart {
  id         String     @id @default(uuid())
  customerId String?
  guestToken String?
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer?  @relation(fields: [customerId], references: [id])
  items      CartItem[]

  @@index([customerId])
  @@index([guestToken])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Wishlist {
  id         String         @id @default(uuid())
  customerId String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  customer   Customer       @relation(fields: [customerId], references: [id])
  items      WishlistItem[]
}

model WishlistItem {
  id              String   @id @default(uuid())
  wishlistId      String
  productId       String
  priceWatch      Boolean  @default(false)
  backInStockAlert Boolean @default(false)
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id])
  wishlist        Wishlist @relation(fields: [wishlistId], references: [id])

  @@unique([wishlistId, productId])
  @@index([productId])
}

model CheckoutSession {
  id                   String         @id @default(uuid())
  customerId            String?
  cartId                String?
  addressId             String?
  deliverySlotId        String?
  paymentMethod         PaymentMethod?
  deliveryInstructions  String?
  couponCode            String?
  status                String         @default("STARTED")
  expiresAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([customerId])
  @@index([cartId])
}

model Order {
  id                      String               @id @default(uuid())
  orderNumber             String               @unique
  customerId              String?
  branchId                String?
  status                  OrderStatus          @default(PLACED)
  paymentStatus           PaymentStatus        @default(PENDING)
  fulfillmentStatus       FulfillmentStatus    @default(NOT_STARTED)
  subtotal                Decimal              @db.Decimal(12, 2)
  discountTotal           Decimal              @default(0) @db.Decimal(12, 2)
  deliveryFee             Decimal              @default(0) @db.Decimal(12, 2)
  total                   Decimal              @db.Decimal(12, 2)
  deliveryAddressSnapshot Json
  placedAt                DateTime             @default(now())
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  branch                  Branch?              @relation(fields: [branchId], references: [id])
  customer                Customer?            @relation(fields: [customerId], references: [id])
  deliveryAssignment      DeliveryAssignment?
  items                   OrderItem[]
  payments                Payment[]
  refunds                 RefundRequest[]
  reviews                 ProductReview[]
  statusHistory           OrderStatusHistory[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String?
  productName     String
  productSlug     String?
  sku             String?
  unit            String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(10, 2)
  lineTotal       Decimal  @db.Decimal(12, 2)
  productSnapshot Json
  order           Order    @relation(fields: [orderId], references: [id])
  product         Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(12, 2)
  providerRef String?
  metadata    Json?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}

model FinanceCodCollection {
  id             String   @id @default(uuid())
  rider          String
  phone          String?
  orders         Int      @default(0)
  collected      Decimal  @default(0) @db.Decimal(12, 2)
  submitted      Decimal  @default(0) @db.Decimal(12, 2)
  difference     Decimal  @default(0) @db.Decimal(12, 2)
  status         String   @default("Pending collection")
  settlementTime String?
  proof          String   @default("Missing")
  owner          String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model FinanceSettlement {
  id            String   @id @default(uuid())
  gateway       String
  batchDate     String?
  expectedDate  String?
  gross         Decimal  @default(0) @db.Decimal(12, 2)
  charges       Decimal  @default(0) @db.Decimal(12, 2)
  deductions    Decimal  @default(0) @db.Decimal(12, 2)
  net           Decimal  @default(0) @db.Decimal(12, 2)
  received      Decimal  @default(0) @db.Decimal(12, 2)
  difference    Decimal  @default(0) @db.Decimal(12, 2)
  status        String   @default("Pending")
  bankReference String?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model FinanceExpense {
  id       String   @id @default(uuid())
  category String
  vendor   String
  amount   Decimal  @default(0) @db.Decimal(12, 2)
  method   String
  paidDate String?
  dueDate  String?
  receipt  String   @default("Missing")
  status   String   @default("Draft")
  note     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model FinanceInvoice {
  id          String   @id @default(uuid())
  reference   String
  party       String
  type        String
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  tax         Decimal  @default(0) @db.Decimal(12, 2)
  date        String?
  status      String   @default("Generated")
  downloadUrl String?
  sentStatus  String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model FinanceReportExport {
  id        String   @id @default(uuid())
  title     String
  format    String
  status    String   @default("Processing")
  dateRange String?
  owner     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model BusinessReportPreference {
  id        String   @id @default(uuid())
  key       String   @unique
  range     String   @default("7 days")
  category  String   @default("All categories")
  payment   String   @default("All payments")
  zone      String   @default("All zones")
  segment   String   @default("All customers")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessReportExport {
  id        String   @id @default(uuid())
  title     String
  format    String
  status    String   @default("Processing")
  time      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([format])
}

model FinanceTaxSettings {
  id              String   @id @default(uuid())
  key             String   @unique @default("default")
  gstCollected    Decimal  @default(0) @db.Decimal(12, 2)
  taxableSales    Decimal  @default(0) @db.Decimal(12, 2)
  exemptSales     Decimal  @default(0) @db.Decimal(12, 2)
  hsnSummary      String?
  invoiceCount    String   @default("0")
  creditNoteCount String   @default("0")
  reviewOwner     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RefundRequest {
  id                 String       @id @default(uuid())
  orderId            String
  reason             String
  note               String?
  status             RefundStatus @default(REQUESTED)
  amount             Decimal?     @db.Decimal(12, 2)
  customerName       String?
  phone              String?
  email              String?
  items              String?
  paymentMethodLabel String?
  refundMethod       String?
  sla                String?
  risk               String?
