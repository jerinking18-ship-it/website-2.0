  updatedAt  DateTime              @updatedAt
  coupon     Coupon?               @relation(fields: [couponId], references: [id])
  placements StorefrontPlacement[]

  @@index([status, placement])
  @@index([priority])
}

model PromotionSyncEventRecord {
